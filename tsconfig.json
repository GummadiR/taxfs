{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@taxfs/shared": [
        "packages/shared/src/index.ts"
      ],
      "@taxfs/kernel": [
        "packages/kernel/src/index.ts"
      ],
      "@taxfs/kernel2": [
        "packages/kernel2/src/index.ts"
      ],
      "@taxfs/spine": [
        "packages/spine/src/index.ts"
      ],
      "@taxfs/gates": [
        "packages/gates/src/index.ts"
      ],
      "@taxfs/forms": [
        "packages/forms/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "supabase/**/*.ts",
    "vitest.config.ts"
  ]
}